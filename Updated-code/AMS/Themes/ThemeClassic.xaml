<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Extremely standard clean OS look -->
    <SolidColorBrush x:Key="PrimaryBg" Color="#2e3440"/>
    <SolidColorBrush x:Key="PrimaryFg" Color="#eceff4"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#3b4252"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#5e81ac"/>
    <SolidColorBrush x:Key="AccentHover" Color="#81a1c1"/>
    <SolidColorBrush x:Key="AccentFg" Color="#ffffff"/>
</ResourceDictionary>
