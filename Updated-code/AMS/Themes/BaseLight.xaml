<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BaseBg" Color="#ffffff"/>
    <SolidColorBrush x:Key="BaseAltBg" Color="#f0f0f0"/>
    <SolidColorBrush x:Key="BaseBorder" Color="#d9d9d9"/>
    
    <SolidColorBrush x:Key="BaseFg" Color="#202020"/>
    <SolidColorBrush x:Key="BaseSecondaryFg" Color="#505050"/>
    <SolidColorBrush x:Key="BaseMutedFg" Color="#808080"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#d13438"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#107c10"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#cf7500"/>
</ResourceDictionary>
