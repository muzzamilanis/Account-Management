<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Original Teal aesthetic from screenshots -->
    <SolidColorBrush x:Key="PrimaryBg" Color="#1e353f"/>
    <SolidColorBrush x:Key="PrimaryFg" Color="#ffffff"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#264653"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#3494b5"/>
    <SolidColorBrush x:Key="AccentHover" Color="#27728d"/>
    <SolidColorBrush x:Key="AccentFg" Color="#ffffff"/>
</ResourceDictionary>
