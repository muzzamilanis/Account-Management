<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Original Teal Theme mimicking the screenshot -->
    <SolidColorBrush x:Key="bg1" Color="#1d3d49"/>
    <SolidColorBrush x:Key="bg2" Color="#ffffff"/>
    <SolidColorBrush x:Key="bg3" Color="#d0d0d0"/>
    <SolidColorBrush x:Key="bg4" Color="#224b59"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#ffffff"/>
    <SolidColorBrush x:Key="TextMuted" Color="#a0aab0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3494b5"/>
    <SolidColorBrush x:Key="AccentHover" Color="#27728d"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#e2e8ed"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#d13438"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#107c10"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#ff8c00"/>

    <!-- Common UI element styles for the themes -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource bg3}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource bg3}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource bg2}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,4,0,2"/>
    </Style>
</ResourceDictionary>
