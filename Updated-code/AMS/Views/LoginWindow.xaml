<Window x:Class="AMS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UserLogin"
        Height="380" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BaseBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBg}" TextElement.Foreground="{DynamicResource PrimaryFg}">
            <StackPanel VerticalAlignment="Center" Margin="28,0">
                <TextBlock Text="Auto Accounts Manager"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryFg}"
                           />
                <TextBlock Text="Please enter your password to continue"
                           FontSize="11" Foreground="#A0FFFFFF"
                            Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="32,20">
            <TextBlock Text="COMPANY" Style="{DynamicResource FieldLabel}"/>
            <TextBlock x:Name="TxtCompany" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource BaseFg}"
                       Margin="0,0,0,16"/>
            <TextBlock Text="PASSWORD" Style="{DynamicResource FieldLabel}"/>
            <PasswordBox x:Name="TxtPass" Width="330" HorizontalAlignment="Left"
                         KeyDown="TxtPass_KeyDown"/>
            <TextBlock x:Name="TxtError" Foreground="{DynamicResource DangerBrush}"
                       Margin="0,10,0,0" FontSize="16" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource PrimaryBg}" Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRegister" Content="Register Now" Width="120"
                        Style="{DynamicResource OutlineButton}"
                        Foreground="{DynamicResource PrimaryFg}" BorderBrush="{DynamicResource PrimaryFg}"
                        Click="BtnRegister_Click"/>
                <Button x:Name="BtnLogin" Content="OK" Width="90"
                        Click="BtnLogin_Click" IsDefault="True"/>
                <Button x:Name="BtnCancel" Content="Cancel" Width="90"
                        Style="{DynamicResource OutlineButton}"
                        Foreground="{DynamicResource PrimaryFg}" BorderBrush="{DynamicResource PrimaryFg}"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
