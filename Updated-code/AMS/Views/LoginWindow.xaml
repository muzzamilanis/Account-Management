<Window x:Class="AMS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login — Auto Management System"
        Height="380" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <DropShadowEffect x:Key="WinShadow" Color="#000000" BlurRadius="32" ShadowDepth="6" Opacity="0.6"/>
    </Window.Resources>
    <Border Margin="14" CornerRadius="14" Background="{DynamicResource BaseBg}" Effect="{DynamicResource WinShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{DynamicResource PrimaryBg}" TextElement.Foreground="{DynamicResource PrimaryFg}">
                <StackPanel VerticalAlignment="Center" Margin="28,0">
                    <TextBlock Text="&#x1F697; Auto Management System"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               />
                    <TextBlock Text="Please enter your password to continue"
                               FontSize="11" Foreground="#A0FFFFFF"
                                Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="32,20">
                <TextBlock Text="COMPANY" Style="{DynamicResource FieldLabel}"/>
                <TextBlock x:Name="TxtCompany" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BaseFg}"
                           Margin="0,0,0,16"/>
                <TextBlock Text="PASSWORD" Style="{DynamicResource FieldLabel}"/>
                <PasswordBox x:Name="TxtPass" Width="330" HorizontalAlignment="Left"
                             KeyDown="TxtPass_KeyDown"/>
                <TextBlock x:Name="TxtError" Foreground="{DynamicResource DangerBrush}"
                           Margin="0,10,0,0" FontSize="16" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" CornerRadius="0,0,14,14"
                    Background="{DynamicResource PrimaryBg}" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLogin" Content="Sign In" Width="110"
                            Click="BtnLogin_Click" IsDefault="True"/>
                    <Button x:Name="BtnCancel" Content="Exit" Width="90"
                            Style="{DynamicResource OutlineButton}" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
