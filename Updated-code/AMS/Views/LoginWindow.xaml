<Window x:Class="AMS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login — Auto Management System"
        Height="380" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <DropShadowEffect x:Key="WinShadow" Color="#000000" BlurRadius="32" ShadowDepth="6" Opacity="0.6"/>
    </Window.Resources>
    <Border Margin="14" CornerRadius="14" Background="{StaticResource bg2}" Effect="{StaticResource WinShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1E3A5F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" Margin="28,0">
                    <TextBlock Text="&#x1F697; Auto Management System"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               />
                    <TextBlock Text="Please enter your password to continue"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                                Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Rectangle Grid.Row="0" Height="2" VerticalAlignment="Bottom">
                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#38BDF8" Offset="0"/>
                    <GradientStop Color="#0F172A" Offset="1"/>
                </LinearGradientBrush></Rectangle.Fill>
            </Rectangle>

            <!-- Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="32,20">
                <TextBlock Text="COMPANY" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="TxtCompany" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,16"/>
                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="TxtPass" Width="330" HorizontalAlignment="Left"
                             KeyDown="TxtPass_KeyDown"/>
                <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}"
                           Margin="0,10,0,0" FontSize="16" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" CornerRadius="0,0,14,14"
                    Background="{StaticResource bg1}" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLogin" Content="Sign In" Width="110"
                            Click="BtnLogin_Click" IsDefault="True"/>
                    <Button x:Name="BtnCancel" Content="Exit" Width="90"
                            Style="{StaticResource OutlineButton}" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
