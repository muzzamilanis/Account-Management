<Window x:Class="AMS.Views.Dialogs.PurchaseAutoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Auto" Width="420" SizeToContent="Height" MaxHeight="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource bg2}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="20,14">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Purchase" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding Stock.Date}" Margin="0,4,0,14"/>
                <TextBlock Text="CHASSIS NUMBER *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Stock.Chassis, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Stock.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="COLOR" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Stock.Color, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="PRICE (YEN)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Stock.PriceYen, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="AMOUNT PAID (YEN)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Stock.PaidYen, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="DUTY (PKR)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Stock.Duty, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="MISC EXPENSE (PKR)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Stock.MiscExpense, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="PAID FROM ACCOUNT" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Margin="0,4,0,14"/>
                <TextBlock Text="AGENT" Style="{StaticResource FieldLabel}"/>
                <DockPanel Margin="0,4,0,14">
                    <Button DockPanel.Dock="Right" Content="Add New" Click="BtnAddAgent_Click"/>
                    <ComboBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}"/>
                </DockPanel>
                <TextBlock Text="COMMENTS" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Stock.Comments, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="54" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
