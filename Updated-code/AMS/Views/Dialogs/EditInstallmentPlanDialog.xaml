<Window x:Class="AMS.Views.Dialogs.EditInstallmentPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Installment Plan" Width="400" SizeToContent="Height" MaxHeight="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource bg2}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="20,14">
            <TextBlock Text="Edit Installment Plan" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Plan" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Padding="24,16">
            <StackPanel>
                <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <TextBlock Text="Already-paid installments are left as-is. The remaining balance is split evenly across the new number of months, starting today."
                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>
                <TextBlock Text="NEW NUMBER OF MONTHS (REMAINING)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="NOTIFY ME (DAYS BEFORE EACH INSTALLMENT DUE)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ReminderDaysBefore, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
