<Window x:Class="AMS.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="380" SizeToContent="Height" MaxHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource bg2}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="20,14">
            <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnYes" Content="Yes" Click="BtnYes_Click" IsDefault="True"/>
                <Button x:Name="BtnNo" Content="No" Style="{StaticResource OutlineButton}" Click="BtnNo_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="24,20">
            <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
        </StackPanel>
    </DockPanel>
</Window>
