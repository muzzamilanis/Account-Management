<Window x:Class="AMS.Views.Dialogs.SaleAutoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sale Auto" Width="400" SizeToContent="Height" MaxHeight="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource bg2}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="20,14">
            <TextBlock Text="Auto Sale Entry" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Record Sale" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Padding="24,16">
            <StackPanel>
                <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding Sale.SaleDate}" Margin="0,4,0,14"/>
                <TextBlock Text="CHASSIS (IN STOCK)" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Chassis}" SelectedItem="{Binding SelectedChassis}" Margin="0,4,0,14"/>
                <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" Margin="0,4,0,14"/>
                <TextBlock Text="SALE PRICE (PKR)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Sale.SalePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="ADVANCE RECEIVED" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Sale.SaleAmountReceived, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="RECEIVED IN ACCOUNT" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Margin="0,4,0,14"/>
                <TextBlock Text="CREDIT DAYS (0 = cash sale, no reminder)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Sale.CreditDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="NOTIFY ME (DAYS BEFORE DUE)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Sale.ReminderDaysBefore, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
