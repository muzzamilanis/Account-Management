<Window x:Class="AMS.Views.Dialogs.AddCustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer" Width="400" SizeToContent="Height" MaxHeight="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource bg2}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="20,14">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Padding="24,16">
            <StackPanel>
                <TextBlock Text="TITLE" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Titles}" SelectedItem="{Binding Customer.Title}" Margin="0,4,0,14"/>
                <TextBlock Text="FULL NAME *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Customer.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="CNIC" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Customer.CNIC, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Customer.Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Customer.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
