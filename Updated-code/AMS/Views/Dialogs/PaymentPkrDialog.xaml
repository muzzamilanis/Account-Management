<Window x:Class="AMS.Views.Dialogs.PaymentPkrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AMS.Views.Controls"
        Title="Payment" Width="440" SizeToContent="Height" MaxHeight="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource bg2}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="20,14">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Enter Payment" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Padding="24,16">
            <StackPanel>
                <!-- Yen fields -->
                <StackPanel Visibility="{Binding IsYen, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding YenPayment.PaymentDate}" Margin="0,4,0,14"/>
                    <TextBlock Text="AMOUNT (YEN)" Style="{StaticResource FieldLabel}"/>
                    <controls:AmountUnitEntry Value="{Binding YenPayment.PaymentAmountYen, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                    <TextBlock Text="EXCHANGE RATE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding YenPayment.PaymentExcRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                    <TextBlock Text="DETAIL" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding YenPayment.PaymentDetail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                </StackPanel>
                <!-- PKR fields -->
                <StackPanel Visibility="{Binding IsYen, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding PkrPayment.PaymentDate}" Margin="0,4,0,14"/>
                    <TextBlock Text="PAYING TO (CUSTOMER)" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,4,0,14">
                        <Button DockPanel.Dock="Right" Content="Add New" Click="BtnAddCustomer_Click"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource FieldLabel}"/>
                    <controls:AmountUnitEntry Value="{Binding PkrPayment.PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                    <TextBlock Text="DETAIL" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding PkrPayment.PaymentDetail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                </StackPanel>
                <TextBlock Text="PAID FROM ACCOUNT" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
