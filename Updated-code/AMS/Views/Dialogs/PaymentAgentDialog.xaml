<Window x:Class="AMS.Views.Dialogs.PaymentAgentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Payment" Width="400" SizeToContent="Height" MaxHeight="750"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource bg2}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="20,14">
            <TextBlock Text="Agent Payment" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Enter Payment" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Padding="24,16">
            <StackPanel>
                <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding Payment.PaymentDate}" Margin="0,4,0,14"/>
                <TextBlock Text="AGENT" Style="{StaticResource FieldLabel}"/>
                <DockPanel Margin="0,4,0,14">
                    <Button DockPanel.Dock="Right" Content="Add New" Click="BtnAddAgent_Click"/>
                    <ComboBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}"/>
                </DockPanel>
                <TextBlock Text="AMOUNT (PKR)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Payment.PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="DETAIL" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Payment.PaymentDetail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="PAID FROM ACCOUNT" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
