<Window x:Class="AMS.Views.Dialogs.ReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Entry" Height="340" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource bg2}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="20,14">
            <TextBlock Text="Receipt Entry" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Enter Receipt" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Padding="24,16">
            <StackPanel>
                <TextBlock Text="RECEIVED FROM" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" Margin="0,4,0,14"/>
                <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding Receipt.ReceiptDate}" Margin="0,4,0,14"/>
                <TextBlock Text="AMOUNT" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Receipt.ReceiptAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="DETAIL" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Receipt.ReceiptDetail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="RECEIVED IN ACCOUNT" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
