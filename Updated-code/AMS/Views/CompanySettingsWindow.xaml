<Window x:Class="AMS.Views.CompanySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AMS.ViewModels"
        Title="Company Settings"
        Height="500" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource bg2}">
    <Window.DataContext>
        <vm:CompanySettingsViewModel/>
    </Window.DataContext>
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="20,14">
            <StackPanel>
                <TextBlock Text="&#x2699; Company Settings" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="This information appears in reports and throughout the app."
                           FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Settings" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
        <!-- Form -->
        <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="COMPANY NAME *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Settings.CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="TAGLINE / DESCRIPTION" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Settings.CompanyTagline, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Settings.CompanyAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Settings.CompanyPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Settings.CompanyEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <Separator Margin="0,8"/>
                <TextBlock Text="DEFAULT EXCHANGE RATE (YEN to PKR)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Settings.DefaultExchangeRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>
                <TextBlock Text="LOGIN PASSWORD" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Settings.LoginPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                <TextBlock Text="Changing the password takes effect on next login."
                           FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,14"/>
                <Separator Margin="0,8"/>
                <CheckBox Content="Enable Customer Credit Sale"
                          IsChecked="{Binding Settings.EnableCreditSales}" Margin="0,8,0,4"/>
                <TextBlock Text="When off, credit-term fields and payment reminders are hidden throughout the app. Existing credit sale data is kept, just not shown."
                           FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
