<Window x:Class="AMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AMS.ViewModels"
        Title="Auto Management System"
        WindowState="Maximized"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource bg2}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ══ TOP HEADER BAR ══ -->
        <Border Grid.Row="0" Background="{StaticResource bg1}"
                BorderBrush="{StaticResource bg3}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="&#x1F697;" FontSize="22" Margin="0,0,8,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center">&#x1F697;</TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCompanyName"
                                   Text="{Binding CompanyName}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   />
                        <TextBlock Text="Auto Dealership Accounts System"
                                   FontSize="10" Foreground="{StaticResource TextMuted}"
                                   />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x2699; Settings" Style="{StaticResource OutlineButton}"
                            Command="{Binding OpenCompanySettingsCommand}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT AREA ══ -->

        <!-- MAIN CONTENT AREA -->
        <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="0">
                    <!-- WELCOME PAGE -->
                    <TabItem Header="Welcome">
                        <Grid x:Name="PageWelcome">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#x1F697;" FontSize="72" HorizontalAlignment="Center"
                                       Margin="0,0,0,20"/>
                            <TextBlock Text="{Binding CompanyName}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Auto Dealership Accounts Manager"
                                       FontSize="14" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,32"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnCreateDb" Content="&#x2795;  Create New Database"
                                        Width="200" Height="44" FontSize="13" Click="BtnCreateDb_Click"/>
                                <Button x:Name="BtnOpenDb" Content="&#x1F4C2;  Open Existing Database"
                                        Style="{StaticResource OutlineButton}"
                                        Width="210" Height="44" FontSize="13" Margin="12,0,0,0"
                                        Click="BtnOpenDb_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDbStatus" Margin="0,20,0,0"
                                       HorizontalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- ACCOUNTS PAGE -->
                    <TabItem Header="Accounts">
                        <Grid x:Name="PageAccounts">
                        <DockPanel>
                            <!-- Sub-nav tabs -->
                            <Border DockPanel.Dock="Top" Background="{StaticResource bg1}"
                                    BorderBrush="{StaticResource bg3}" BorderThickness="0,0,0,1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Margin="16,0">
                                        <RadioButton x:Name="TabCashBank" Content="Cash/Bank" GroupName="AccTab"
                                                     IsChecked="True" Style="{StaticResource NavItemStyle}"
                                                     Padding="12,10" Margin="2,0"/>
                                        <RadioButton x:Name="TabTransfer" Content="A/c Transfer" GroupName="AccTab"
                                                     Style="{StaticResource NavItemStyle}" Padding="12,10" Margin="2,0"/>
                                        <RadioButton x:Name="TabMisc" Content="Misc Expense" GroupName="AccTab"
                                                     Style="{StaticResource NavItemStyle}" Padding="12,10" Margin="2,0"/>
                                        <RadioButton x:Name="TabDuty" Content="Duty Payments" GroupName="AccTab"
                                                     Style="{StaticResource NavItemStyle}" Padding="12,10" Margin="2,0"/>
                                        <RadioButton x:Name="TabOfficeExp" Content="Office Expense" GroupName="AccTab"
                                                     Style="{StaticResource NavItemStyle}" Padding="12,10" Margin="2,0"/>
                                        <RadioButton x:Name="TabReceipts" Content="Receipts" GroupName="AccTab"
                                                     Style="{StaticResource NavItemStyle}" Padding="12,10" Margin="2,0"/>
                                        <RadioButton x:Name="TabYen" Content="Yen Payments" GroupName="AccTab"
                                                     Style="{StaticResource NavItemStyle}" Padding="12,10" Margin="2,0"/>
                                        <RadioButton x:Name="TabParty" Content="Party Payments" GroupName="AccTab"
                                                     Style="{StaticResource NavItemStyle}" Padding="12,10" Margin="2,0"/>
                                        <RadioButton x:Name="TabAgent" Content="Agent Payments" GroupName="AccTab"
                                                     Style="{StaticResource NavItemStyle}" Padding="12,10" Margin="2,0"/>
                                        <RadioButton x:Name="TabProfit" Content="Profit Withdrawal" GroupName="AccTab"
                                                     Style="{StaticResource NavItemStyle}" Padding="12,10" Margin="2,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Sub-content -->
                            <Grid DockPanel.Dock="Top" x:Name="AccSubContent">
                                <!-- Cash/Bank Accounts -->
                                <Grid x:Name="SubCashBank">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabCashBank}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,0"
                                                VerticalAlignment="Center">
                                        <Button Content="&#x2795; Add Account" x:Name="BtnAddAccount"
                                                Click="BtnAddAccount_Click"/>
                                        <Button Content="&#x270F; Edit Selected" x:Name="BtnEditAccount"
                                                Style="{StaticResource OutlineButton}" IsEnabled="False"
                                                Click="BtnEditAccount_Click"/>
                                        <Separator Width="1" Height="24" Margin="8,0" Background="{StaticResource bg3}"/>
                                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="TxtAccFilter" Width="180" Height="28"
                                                 TextChanged="TxtAccFilter_TextChanged"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="16,0,16,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Account list -->
                                        <Border Style="{StaticResource CardBorder}" Margin="0,8,8,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Accounts"
                                                           Style="{StaticResource SectionHeader}"/>
                                                <ListBox x:Name="LstAccounts" SelectionChanged="LstAccounts_SelectionChanged">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding AccountType}"
                                                                           Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>
                                        </Border>
                                        <!-- Account Detail -->
                                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,8,0,0"
                                                DataContext="{Binding SelectedItem, ElementName=LstAccounts}">
                                            <StackPanel Visibility="{Binding Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="Account Details" Style="{StaticResource SectionHeader}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="32"/>
                                                        <RowDefinition Height="32"/>
                                                        <RowDefinition Height="32"/>
                                                        <RowDefinition Height="32"/>
                                                        <RowDefinition Height="32"/>
                                                        <RowDefinition Height="32"/>
                                                        <RowDefinition Height="32"/>
                                                        <RowDefinition Height="32"/>
                                                        <RowDefinition Height="32"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="Type:" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccountType}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="1" Text="Name:" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccountName}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="2" Text="Account No:" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccountNumber}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="3" Text="Title:" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccountTitle}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="4" Text="Bank:" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BankName}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="5" Text="Branch:" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BankBranch}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="6" Text="Opening Balance:" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OpeningBalance, StringFormat='N2'}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="7" Text="Current Balance:" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CurrentBalance, StringFormat='N2'}"
                                                               FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentBrush}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- A/c Transfer -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabTransfer}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <DockPanel Margin="16">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="&#x21C4; New Transfer" Click="BtnNewTransfer_Click"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource CardBorder}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Account Transfers" Style="{StaticResource SectionHeader}"/>
                                                <DataGrid x:Name="GridTransfers" AutoGenerateColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yyyy'}" Width="100"/>
                                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='N2'}" Width="100"/>
                                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                                                        <DataGridTextColumn Header="Credit From" Binding="{Binding CreditFrom}" Width="130"/>
                                                        <DataGridTextColumn Header="Debit To" Binding="{Binding DebitTo}" Width="130"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </Grid>

                                <!-- Misc Expense -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabMisc}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <DockPanel Margin="16">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="&#x2795; New Misc Expense" Click="BtnNewMiscExp_Click"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource CardBorder}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Misc Auto Expenses" Style="{StaticResource SectionHeader}"/>
                                                <DataGrid x:Name="GridMiscExp" AutoGenerateColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Chassis" Binding="{Binding Chassis}" Width="120"/>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding MiscExpDate, StringFormat='dd MMM yyyy'}" Width="100"/>
                                                        <DataGridTextColumn Header="Amount" Binding="{Binding MiscExpAmount, StringFormat='N2'}" Width="100"/>
                                                        <DataGridTextColumn Header="Detail" Binding="{Binding MiscExpDetail}" Width="*"/>
                                                        <DataGridTextColumn Header="Account" Binding="{Binding MiscExpPaidBy}" Width="130"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </Grid>

                                <!-- Duty Expense -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabDuty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <DockPanel Margin="16">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="&#x2795; New Duty Expense" Click="BtnNewDutyExp_Click"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource CardBorder}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Duty Expenses" Style="{StaticResource SectionHeader}"/>
                                                <DataGrid x:Name="GridDutyExp" AutoGenerateColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Chassis" Binding="{Binding Chassis}" Width="120"/>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding DutyExpDate, StringFormat='dd MMM yyyy'}" Width="100"/>
                                                        <DataGridTextColumn Header="Amount" Binding="{Binding DutyExpAmount, StringFormat='N2'}" Width="100"/>
                                                        <DataGridTextColumn Header="Detail" Binding="{Binding DutyExpDetail}" Width="*"/>
                                                        <DataGridTextColumn Header="Agent" Binding="{Binding DutyExpAgent}" Width="120"/>
                                                        <DataGridTextColumn Header="Account" Binding="{Binding DutyExpPaidBy}" Width="120"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </Grid>

                                <!-- Office Expense -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabOfficeExp}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <DockPanel Margin="16">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="&#x2795; New Office Expense" Click="BtnNewOfficeExp_Click"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource CardBorder}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Office Expenses" Style="{StaticResource SectionHeader}"/>
                                                <DataGrid x:Name="GridOfficeExp" AutoGenerateColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding OfficeExpDate, StringFormat='dd MMM yyyy'}" Width="100"/>
                                                        <DataGridTextColumn Header="Amount" Binding="{Binding OfficeExpAmount, StringFormat='N2'}" Width="110"/>
                                                        <DataGridTextColumn Header="Detail" Binding="{Binding OfficeExpDetail}" Width="*"/>
                                                        <DataGridTextColumn Header="Account" Binding="{Binding OfficeExpPaidBy}" Width="140"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </Grid>

                                <!-- Receipts -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabReceipts}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <DockPanel Margin="16">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="&#x2795; New Receipt" Click="BtnNewReceipt_Click"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource CardBorder}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Receipts" Style="{StaticResource SectionHeader}"/>
                                                <DataGrid x:Name="GridReceipts" AutoGenerateColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding ReceiptDate, StringFormat='dd MMM yyyy'}" Width="100"/>
                                                        <DataGridTextColumn Header="Amount" Binding="{Binding ReceiptAmount, StringFormat='N2'}" Width="110"/>
                                                        <DataGridTextColumn Header="Detail" Binding="{Binding ReceiptDetail}" Width="*"/>
                                                        <DataGridTextColumn Header="Received In" Binding="{Binding ReceivedIn}" Width="130"/>
                                                        <DataGridTextColumn Header="From" Binding="{Binding ReceivedFrom}" Width="130"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </Grid>

                                <!-- Yen Payments -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabYen}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <DockPanel Margin="16">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="&#x2795; New Yen Payment" Click="BtnNewYenPayment_Click"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource CardBorder}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Yen Payments" Style="{StaticResource SectionHeader}"/>
                                                <DataGrid x:Name="GridYenPayments" AutoGenerateColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat='dd MMM yyyy'}" Width="100"/>
                                                        <DataGridTextColumn Header="Amount (Yen)" Binding="{Binding PaymentAmountYen, StringFormat='N0'}" Width="110"/>
                                                        <DataGridTextColumn Header="Rate" Binding="{Binding PaymentExcRate, StringFormat='N2'}" Width="80"/>
                                                        <DataGridTextColumn Header="Amount (PKR)" Binding="{Binding PaymentAmountPkr, StringFormat='N2'}" Width="120"/>
                                                        <DataGridTextColumn Header="Detail" Binding="{Binding PaymentDetail}" Width="*"/>
                                                        <DataGridTextColumn Header="Account" Binding="{Binding PaidFrom}" Width="130"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </Grid>

                                <!-- Party Payments -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabParty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <DockPanel Margin="16">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="&#x2795; New Party Payment" Click="BtnNewPkrPayment_Click"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource CardBorder}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Party Payments" Style="{StaticResource SectionHeader}"/>
                                                <DataGrid x:Name="GridPkrPayments" AutoGenerateColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat='dd MMM yyyy'}" Width="100"/>
                                                        <DataGridTextColumn Header="Amount" Binding="{Binding PaymentAmount, StringFormat='N2'}" Width="110"/>
                                                        <DataGridTextColumn Header="Detail" Binding="{Binding PaymentDetail}" Width="*"/>
                                                        <DataGridTextColumn Header="Account" Binding="{Binding PaidFrom}" Width="130"/>
                                                        <DataGridTextColumn Header="Customer" Binding="{Binding PaidTo}" Width="130"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </Grid>

                                <!-- Agent Payments -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabAgent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <DockPanel Margin="16">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Content="&#x2795; New Agent Payment" Click="BtnNewAgentPayment_Click"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource CardBorder}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Agent Payments" Style="{StaticResource SectionHeader}"/>
                                                <DataGrid x:Name="GridAgentPayments" AutoGenerateColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat='dd MMM yyyy'}" Width="100"/>
                                                        <DataGridTextColumn Header="Amount" Binding="{Binding PaymentAmount, StringFormat='N2'}" Width="110"/>
                                                        <DataGridTextColumn Header="Detail" Binding="{Binding PaymentDetail}" Width="*"/>
                                                        <DataGridTextColumn Header="Account" Binding="{Binding PaidFrom}" Width="130"/>
                                                        <DataGridTextColumn Header="Agent" Binding="{Binding PaidTo}" Width="130"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </Grid>

                                <!-- Profit Withdrawal -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabProfit}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                                        <TextBlock Text="&#x1F4B8;" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Total Profit Available" FontSize="13"
                                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTotalProfit" FontSize="32" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"
                                                   Margin="0,8,0,24"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Amount to Withdraw:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBox x:Name="TxtWithdrawAmount" Width="150"/>
                                            <TextBlock Text="From Account:" VerticalAlignment="Center" Margin="12,0"/>
                                            <ComboBox x:Name="ComboProfitAccount" Width="160"/>
                                            <Button Content="Withdraw" Click="BtnWithdrawProfit_Click" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- STOCKS PAGE -->
                    <TabItem Header="Manage Stocks">
                        <Grid>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10,16,0">
                                <Button Content="&#x2795; Add Stock" Click="BtnAddStock_Click"/>
                                <Button Content="&#x270F; Edit" Style="{StaticResource OutlineButton}"
                                        x:Name="BtnEditStock" IsEnabled="False" Click="BtnEditStock_Click"/>
                                <Separator Width="1" Height="24" Margin="8,0" Background="{StaticResource bg3}"/>
                                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtStockFilter" Width="180" Height="28"
                                         TextChanged="TxtStockFilter_TextChanged"/>
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,8,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Inventory" Style="{StaticResource SectionHeader}"/>
                                        <ListBox x:Name="LstStocks" SelectionChanged="LstStocks_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Chassis}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Model}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                                        DataContext="{Binding SelectedItem, ElementName=LstStocks}">
                                    <StackPanel Visibility="{Binding Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="Stock Details" Style="{StaticResource SectionHeader}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Chassis No:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Chassis}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Grid.Column="2" Text="Model:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Model}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Text="Color:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Color}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Status:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Status}" FontWeight="Bold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                            <TextBlock Grid.Row="2" Text="Price (Yen):" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PriceYen, StringFormat='N0'}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Rate:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Rate, StringFormat='N2'}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="3" Text="Price (PKR):" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PricePkr, StringFormat='N2'}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Duty:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Duty, StringFormat='N2'}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="4" Text="Misc Expense:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MiscExpense, StringFormat='N2'}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Total Cost:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Cost, StringFormat='N2'}"
                                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Grid.Row="5" Text="Paid (Yen):" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PaidYen, StringFormat='N0'}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Bal. Yen:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding BalanceYen, StringFormat='N0'}"
                                                       FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                            <TextBlock Grid.Row="6" Text="Comments:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Comments}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                    </TabItem>

                    <!-- CUSTOMERS PAGE -->
                    <TabItem Header="Manage Parties">
                        <Grid>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10,16,0">
                                <Button Content="&#x2795; Add Customer" Click="BtnAddCust_Click"/>
                                <Button Content="&#x270F; Edit" Style="{StaticResource OutlineButton}"
                                        x:Name="BtnEditCust" IsEnabled="False" Click="BtnEditCust_Click"/>
                                <Separator Width="1" Height="24" Margin="8,0" Background="{StaticResource bg3}"/>
                                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtCustFilter" Width="180" Height="28"
                                         TextChanged="TxtCustFilter_TextChanged"/>
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,8,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Customers" Style="{StaticResource SectionHeader}"/>
                                        <ListBox x:Name="LstCust" SelectionChanged="LstCust_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Phone}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                                        DataContext="{Binding SelectedItem, ElementName=LstCust}">
                                    <StackPanel Visibility="{Binding Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="Customer Details" Style="{StaticResource SectionHeader}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Full Name:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="15"/>
                                            <TextBlock Grid.Row="1" Text="CNIC:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CNIC}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="2" Text="Phone:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Phone}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="3" Text="Address:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Address}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="4" Text="Payment Received:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PaymentReceived, StringFormat='PKR N2'}"
                                                       FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock Grid.Row="5" Text="Payment Receivable:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PaymentReceivable, StringFormat='PKR N2'}"
                                                       FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                    </TabItem>

                    <!-- AGENTS PAGE -->
                    <TabItem Header="Manage Agents">
                        <Grid>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10,16,0">
                                <Button Content="&#x2795; Add Agent" Click="BtnAddAgent_Click"/>
                                <Button Content="&#x270F; Edit" Style="{StaticResource OutlineButton}"
                                        x:Name="BtnEditAgent" IsEnabled="False" Click="BtnEditAgent_Click"/>
                                <Separator Width="1" Height="24" Margin="8,0" Background="{StaticResource bg3}"/>
                                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBox x:Name="TxtAgentFilter" Width="180" Height="28"
                                         TextChanged="TxtAgentFilter_TextChanged"/>
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,8,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Agents" Style="{StaticResource SectionHeader}"/>
                                        <ListBox x:Name="LstAgent" SelectionChanged="LstAgent_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Phone}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                                        DataContext="{Binding SelectedItem, ElementName=LstAgent}">
                                    <StackPanel Visibility="{Binding Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="Agent Details" Style="{StaticResource SectionHeader}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Name:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="15"/>
                                            <TextBlock Grid.Row="1" Text="CNIC:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CNIC}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="2" Text="Phone:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Phone}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="3" Text="Address:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Address}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="4" Text="Receivable:" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PaymentReceivable, StringFormat='PKR N2'}"
                                                       FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                    </TabItem>
                    <!-- SALES PAGE -->
                    <TabItem Header="Sale Autos">
                        <Grid>
                        <DockPanel Margin="16">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="&#x2795; New Sale Entry" Click="BtnNewSale_Click"/>
                                <Button Content="&#x1F504; Refresh" Style="{StaticResource OutlineButton}" Click="BtnRefreshSales_Click"/>
                            </StackPanel>
                            <Border Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Sales History" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid x:Name="GridSales" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat='dd MMM yyyy'}" Width="100"/>
                                            <DataGridTextColumn Header="Chassis" Binding="{Binding SaleChassis}" Width="130"/>
                                            <DataGridTextColumn Header="Customer" Binding="{Binding SaleCustomer}" Width="150"/>
                                            <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePrice, StringFormat='N2'}" Width="120"/>
                                            <DataGridTextColumn Header="Advance Received" Binding="{Binding SaleAmountReceived, StringFormat='N2'}" Width="140"/>
                                            <DataGridTextColumn Header="Balance" Binding="{Binding SaleBalance, StringFormat='N2'}" Width="120"/>
                                            <DataGridTextColumn Header="Received In" Binding="{Binding PaymentReceivedIn}" Width="130"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Grid>
                    </TabItem>
                    <!-- REPORTS PAGE -->
                    <TabItem Header="Reports">
                        <Grid>
                        <DockPanel>
                            <!-- Report controls toolbar -->
                            <Border DockPanel.Dock="Top" Background="{StaticResource bg1}"
                                    BorderBrush="{StaticResource bg3}" BorderThickness="0,0,0,1" Padding="16,10">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Report:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ComboReport" Width="200" Margin="0,0,16,0"
                                              SelectionChanged="ComboReport_SelectionChanged"/>
                                    <TextBlock Text="From:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="DpReportFrom" Width="130" Margin="0,0,12,0"
                                                SelectedDate="2017-01-01"/>
                                    <TextBlock Text="To:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="DpReportTo" Width="130" Margin="0,0,16,0"/>
                                    <Button Content="&#x25B6; Generate" Margin="0,0,8,0"
                                            Click="BtnGenerateReport_Click"/>
                                    <Button Content="&#x1F5A8; Print" Style="{StaticResource OutlineButton}"
                                            x:Name="BtnPrint" IsEnabled="False" Click="BtnPrint_Click"/>
                                </WrapPanel>
                            </Border>

                            <!-- Report area: empty state + viewer -->
                            <Grid>
                                <!-- Empty state -->
                                <StackPanel x:Name="PnlReportEmpty"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="Visible">
                                    <TextBlock Text="&#x1F4CA;" FontSize="64" HorizontalAlignment="Center"
                                               Margin="0,0,0,16" Opacity="0.4"/>
                                    <TextBlock Text="No Report Generated"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Select a report type, set the date range, then click Generate."
                                               FontSize="12" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="#1A38BDF8" BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="1. Choose report   " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <TextBlock Text="2. Set dates   " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <TextBlock Text="3. Click " Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <TextBlock Text="Generate" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Report viewer -->
                                <Border x:Name="PnlReportViewer" Margin="16" Visibility="Collapsed"
                                        Background="White" CornerRadius="8"
                                        BorderBrush="{StaticResource bg3}" BorderThickness="1">
                                    <DockPanel>
                                        <!-- Report header bar -->
                                        <Border DockPanel.Dock="Top"
                                                Background="{StaticResource bg1}"
                                                BorderBrush="{StaticResource bg3}" BorderThickness="0,0,0,1"
                                                CornerRadius="8,8,0,0" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x1F4C4; " FontSize="14"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock x:Name="TxtReportTitle" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock x:Name="TxtReportCount" FontSize="11"
                                                               Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="TxtReportDate" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <FlowDocumentScrollViewer x:Name="ReportViewer"
                                                                   VerticalScrollBarVisibility="Auto"
                                                                   HorizontalScrollBarVisibility="Auto"
                                                                   Background="White"
                                                                   Padding="0"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                    </TabItem>
        </TabControl>


        <!-- ══ STATUS BAR ══ -->
        <Border Grid.Row="2" Background="{StaticResource bg1}"
                BorderBrush="{StaticResource bg3}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource TextMuted}" Text="Ready — Open or create a database to begin"/>
                
                <!-- Classic Exchange Rate UX -->
                <WrapPanel Grid.Column="1" Name="WrapExcEdit" Visibility="Collapsed" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Label Content="Amount in Yen:" />
                    <TextBox Name="txtEditExcRate" Width="60" Text="{Binding ExchangeRate, UpdateSourceTrigger=Explicit}" Margin="0,0,10,0"/>
                    <Button Name="btnExcEdit" Content="OK" Width="50" Click="btnExcEdit_Click"/>
                </WrapPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" x:Name="PnlExcView">
                    <Label Content="Exchange Rate : " />
                    <Label Name="lblExcRate" Content="{Binding ExchangeRate}" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                        <Hyperlink Name="hyplnk" Click="hyplnk_Click">Edit Rate</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="6" VerticalAlignment="Center" FontSize="10"
                           Foreground="{StaticResource TextMuted}" Text="Powered by Soft-Tech Solutions"/>
            </Grid>
        </Border>
    </Grid>
</Window>

