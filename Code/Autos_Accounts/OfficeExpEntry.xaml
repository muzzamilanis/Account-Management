<!--Class 'Autos_Accounts.OfficeExpEntry' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
    x:Class="Autos_Accounts.OfficeExpEntry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:local="clr-namespace:Autos_Accounts"
    Title="Office Expense Entry"
    Height="330" Width="380"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="{StaticResource bg1}">

    <DockPanel Name="dockSaleEntry" LastChildFill="True">

        <!-- Title Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="18 14">
            <StackPanel>
                <TextBlock Name="AccInfoText"
                           Text="New Office Expense Entry"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           FontFamily="Segoe UI Variable, Segoe UI"/>
                <Rectangle Height="1.5" Margin="0 8 0 0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#38BDF8" Offset="0"/>
                            <GradientStop Color="#0F172A" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="12 10">
            <WrapPanel HorizontalAlignment="Right">
                <Button Name="OK" Content="Save Entry" Width="100" IsDefault="True"/>
                <Button Name="Cancel" Content="Cancel" Width="80" IsCancel="True"
                        Style="{StaticResource OutlineButton}"/>
            </WrapPanel>
        </Border>

        <!-- Form Body -->
        <Border Background="{StaticResource bg2}" Padding="14 8">
            <StackPanel Name="UniOfficeDetails" VerticalAlignment="Top">
                <WrapPanel>
                    <Label>Date:</Label>
                    <DatePicker Name="OfficedatePicker" SelectedDateFormat="Short"
                                SelectedDate="{x:Static sys:DateTime.Now}"/>
                </WrapPanel>
                <WrapPanel>
                    <Label>Expense Amount:</Label>
                    <TextBox Name="txtOfficeExpAmount" ContextMenu="{x:Null}"/>
                </WrapPanel>
                <WrapPanel>
                    <Label>Expense Detail:</Label>
                    <TextBox Name="txtOfficeExpDetail"/>
                </WrapPanel>
                <WrapPanel>
                    <Label>Payment by:</Label>
                    <ComboBox Name="comboOfficeAccounts" HorizontalAlignment="Left"
                              VerticalAlignment="Top" ItemsSource="{Binding BankAccounts}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
