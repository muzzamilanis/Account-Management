<!--Class 'Autos_Accounts.MainWindow' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
	x:Class="Autos_Accounts.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
	xmlns:xrd="clr-namespace:CodeReason.Reports.Document;assembly=CodeReason.Reports"
	xmlns:local="clr-namespace:Autos_Accounts"
	Title="Jaini Auto Accounts Manager"
	WindowState="Maximized"
	MinHeight="600"
	Height="644"
	Width="800"
	Background="{StaticResource bg1}"
	Foreground="{StaticResource TextPrimary}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<local:MultiCheckedToEnabledConverter
				x:Key="MultiCheckedToEnabledConverter" />
			<LinearGradientBrush
				StartPoint="0,0"
				EndPoint="1,0"
				x:Key="SelectedBorderBrush">
				<GradientBrush.GradientStops>
					<GradientStopCollection>
						<GradientStop
							Color="Gray"
							Offset="0.965" />
						<GradientStop
							Color="WhiteSmoke"
							Offset="1.0" />
					</GradientStopCollection>
				</GradientBrush.GradientStops>
			</LinearGradientBrush>
			<Style
				TargetType="{x:Type TabControl}"
				x:Key="{x:Type TabControl}">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabControl}">
							<DockPanel>
								<!-- Sidebar panel -->
								<Border Panel.ZIndex="50"
										Margin="0,0,0,0"
										Width="210"
										BorderThickness="0,0,1,0"
										Background="{StaticResource bg1}"
										BorderBrush="{StaticResource bg3}"
										Height="{Binding ElementName=MainGrid, Path=ActualHeight}">
									<TabPanel Margin="0" IsItemsHost="True"/>
								</Border>
								<!-- Content panel -->
								<Border Background="{StaticResource bg2}"
										BorderThickness="0"
										Padding="8,8,4,8">
									<ContentPresenter ContentSource="SelectedContent"/>
								</Border>
							</DockPanel>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style
				TargetType="{x:Type DockPanel}"
				x:Key="{x:Type DockPanel}">
				<Setter
					Property="Margin"
					Value="3" />
			</Style>
			<!-- Modern TabItem: left accent indicator + hover state -->
			<Style TargetType="{x:Type TabItem}" x:Key="{x:Type TabItem}">
				<Setter Property="Foreground"        Value="{StaticResource TextSecondary}"/>
				<Setter Property="FontFamily"        Value="Segoe UI Variable, Segoe UI"/>
				<Setter Property="FontSize"          Value="12"/>
				<Setter Property="Padding"           Value="14 11 10 11"/>
				<Setter Property="Background"        Value="Transparent"/>
				<Setter Property="Cursor"            Value="Hand"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabItem}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="3"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<!-- Left accent bar -->
								<Border Name="AccentBar"
										Grid.Column="0"
										Background="Transparent"
										CornerRadius="0 2 2 0"/>
								<!-- Tab background + content -->
								<Border Name="Border"
										Grid.Column="1"
										Background="{TemplateBinding Background}"
										BorderThickness="0"
										CornerRadius="0 6 6 0"
										Padding="{TemplateBinding Padding}">
									<ContentPresenter Name="ContentSite"
													  ContentSource="Header"
													  Width="178"
													  VerticalAlignment="Center">
										<FrameworkElement.Resources>
											<ResourceDictionary>
												<Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}">
													<Setter Property="Padding" Value="2 0"/>
												</Style>
											</ResourceDictionary>
										</FrameworkElement.Resources>
									</ContentPresenter>
								</Border>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Border"    Property="Background"  Value="{StaticResource SurfaceHover}"/>
									<Setter Property="Foreground"                        Value="{StaticResource TextPrimary}"/>
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentBrush}"/>
									<Setter TargetName="Border"    Property="Background" Value="{StaticResource bg2}"/>
									<Setter TargetName="ContentSite" Property="FontSize" Value="13"/>
									<Setter Property="Foreground"                        Value="{StaticResource AccentBrush}"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="0,1,0,-1">
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type StackPanel}"
					x:Key="{x:Type StackPanel}">
					<Setter
						Property="Margin"
						Value="2" />
					<Setter
						Property="VerticalAlignment"
						Value="center" />
				</Style>
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Grid.RowDefinitions>
			<RowDefinition Height="72"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="48"/>
		</Grid.RowDefinitions>
		<!-- ══ Footer Status Bar (Row 2) ══ -->
		<Border Grid.Row="2"
				Background="{StaticResource bg1}"
				BorderBrush="{StaticResource bg3}"
				BorderThickness="0,1,0,0"
				Padding="16 0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Exchange-rate edit (hidden by default, shown from code-behind) -->
				<WrapPanel Name="WrapExcEdit" Visibility="Hidden"
						   Grid.Column="0" VerticalAlignment="Center">
					<Label Foreground="{StaticResource TextSecondary}">Amount in Yen:</Label>
					<TextBox Name="txtEditExcRate"
							 Text="{Binding Source={x:Static local:MySettings.Default}, Path=exchangeRate, Mode=TwoWay}"
							 ContextMenu="{x:Null}"/>
					<Button Name="btnExcEdit" Content="OK" Width="70" IsDefault="True"/>
				</WrapPanel>

				<!-- Exchange-rate display -->
				<WrapPanel Name="WrapExcRate" Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Name="txtExcRate">
						<Hyperlink Name="hyplnk">Edit Rate<FrameworkContentElement.Style><Style TargetType="{x:Type Hyperlink}"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Style.Triggers><Trigger Property="ContentElement.IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentHover}"/></Trigger></Style.Triggers></Style></FrameworkContentElement.Style></Hyperlink>
						<Run Text=" ￥" FontSize="14"/>
						<Run FontSize="14" FontWeight="SemiBold"
							 Text="{Binding Source={x:Static local:MySettings.Default}, Path=exchangeRate, Mode=TwoWay}"/>
					</TextBlock>
				</WrapPanel>

				<!-- Yen-adjust link (shown from code-behind when needed) -->
				<WrapPanel Name="AdjustLink" Grid.Column="1"
						   Visibility="Collapsed" HorizontalAlignment="Center"
						   VerticalAlignment="Center">
					<TextBlock>
						<Hyperlink Name="BtnYenAdjust">Click here to Adjust Stock Amount Payable<FrameworkContentElement.Style><Style TargetType="{x:Type Hyperlink}"><Setter Property="Foreground" Value="{StaticResource bg4}"/><Style.Triggers><Trigger Property="ContentElement.IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger></Style.Triggers></Style></FrameworkContentElement.Style></Hyperlink>
					</TextBlock>
				</WrapPanel>

				<!-- Developer credit -->
				<WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
					<TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
						<Run Text="Developed by: "/>
						<Hyperlink Name="hyplnk2">hostineasy.com<FrameworkContentElement.Style><Style TargetType="{x:Type Hyperlink}"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Style.Triggers><Trigger Property="ContentElement.IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentHover}"/></Trigger></Style.Triggers></Style></FrameworkContentElement.Style></Hyperlink>
					</TextBlock>
				</WrapPanel>
			</Grid>
		</Border>
		<!-- ══ App Title Bar (Row 0) ══ -->
		<Border Background="{StaticResource bg1}" BorderBrush="{StaticResource bg3}"
				BorderThickness="0,0,0,1" Padding="24 0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="Jaini Auto Accounts Manager"
							   FontSize="24" FontWeight="Bold"
							   FontFamily="Segoe UI Variable, Segoe UI"
							   Foreground="{StaticResource AccentBrush}"/>
					<TextBlock Text="Auto Dealership Accounts System"
							   FontSize="11"
							   FontFamily="Segoe UI Variable, Segoe UI"
							   Foreground="{StaticResource TextMuted}"
							   Margin="0 2 0 0"/>
				</StackPanel>
			</Grid>
		</Border>
		<DockPanel
			Name="stackData"
			Grid.Row="1"
			Margin="0">
			<TabControl
				Name="MainGrid"
				TabStripPlacement="Left">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type TabItem}"
							x:Key="SideBarSectionStyle">
							<Setter
								Property="IsEnabled"
								Value="False" />
							<Setter
								Property="FontSize"
								Value="16" />
							<Setter
								Property="Foreground"
								Value="#FF90EE90" />
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
				<TabItem
					Header="Welcome"
					IsSelected="True">
					<StackPanel>
						<Button
							Name="BtnCreateData">Create New Database</Button>
						<Button
							Name="BtnOpenData">Open Existing Database</Button>
					</StackPanel>
				</TabItem>
				<TabItem
					Header="Accounts">
					<Grid>
						<TabControl
							Name="TabCtrAccounts"
							TabStripPlacement="Left">
							<TabItem
								Header="Cash / Bank Accounts">
								<Grid
									Name="MainAccounts">
									<DockPanel
										Name="staAccounts">
										<StackPanel
											Name="GrpAccountsBtns"
											DockPanel.Dock="Top"
											Orientation="Horizontal"
											HorizontalAlignment="Center">
											<Button
												Name="BtnAddAccount"
												IsEnabled="False">Add Account</Button>
											<Button
												Name="BtnEditAccount"
												IsEnabled="False">Edit Selected Account</Button>
											<Button
												Name="BtnDeleteAccount"
												Visibility="Collapsed"
												IsEnabled="False">Delete Selected Account</Button>
										</StackPanel>
										<Grid
											Margin="2"
											DockPanel.Dock="Top"
											HorizontalAlignment="Left"
											Height="30"
											Width="{Binding ElementName=LstAccounts, Path=ActualWidth}">
											<Grid.ColumnDefinitions>
												<ColumnDefinition
													Width="Auto" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>
											<Label
												Content="Filter:"
												HorizontalAlignment="Left" />
											<TextBox
												Name="txtAccountFilter"
												Grid.Column="1"
												Width="auto" />
										</Grid>
										<StackPanel
											DockPanel.Dock="Bottom">
											<TextBlock
												DockPanel.Dock="Bottom">
												<Run
													Text="Total Accounts: " /> <Run
													FontWeight="Bold"
													Text="{Binding ElementName=LstAccounts, Path=Items.Count, Mode=OneWay}" /></TextBlock>
										</StackPanel>
										<Grid
											Name="AccountsGrid">
											<Grid.ColumnDefinitions>
												<ColumnDefinition
													Width="4*" />
												<ColumnDefinition
													Width="6*" />
											</Grid.ColumnDefinitions>
											<ListView
												Name="LstAccounts"
												DockPanel.Dock="Left"
												SelectionMode="Single">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<TextBlock
															Text="{Binding AccountName}" />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ListView>
											<DockPanel
												Name="AccountDetails"
												Grid.Column="1"
												VerticalAlignment="Top"
												DataContext="{Binding ElementName=LstAccounts, Path=SelectedItem}">
												<TextBlock
													DockPanel.Dock="Top"
													HorizontalAlignment="Center"
													FontWeight="Bold"
													Text="Selected Account Details"
													LineHeight="25" />
												<ScrollViewer
													VerticalScrollBarVisibility="Auto">
													<TextBlock
														Name="TxtBlkAccountDetails"
														FontFamily="Segoe UI"
														ScrollViewer.HorizontalScrollBarVisibility="Disabled"
														LineHeight="25">
														<Run
															Text="Account Id: " /> <Run
															Name="runRowId"
															FontWeight="Bold"
															Text="{Binding rowid}" /><LineBreak /><Run
															Text="Date: " /> <Run
															Name="runDate"
															FontWeight="Bold"
															Text="{Binding AccountDate}" /><LineBreak /><Run
															Text="A/c Type: " /> <Run
															Name="runAccountType"
															FontWeight="Bold"
															Text="{Binding AccountType}" /><LineBreak /><Run
															Text="A/c Name: " /> <Run
															Name="runAccountName"
															FontWeight="Bold"
															Text="{Binding AccountName}" /><LineBreak /><Run
															Text="A/c No.: " /> <Run
															Name="runAccountNumber"
															FontWeight="Bold"
															Text="{Binding AccountNumber}" /><LineBreak /><Run
															Text="Title: " /> <Run
															Name="runAccountTitle"
															FontWeight="Bold"
															Text="{Binding AccountTitle}" /><LineBreak /><Run
															Text="Bank: " /> <Run
															Name="runBankName"
															FontWeight="Bold"
															Text="{Binding BankName}" /><LineBreak /><Run
															Text="Branch: " /> <Run
															Name="runBankBranch"
															FontWeight="Bold"
															Text="{Binding BankBranch}" /><LineBreak /><Run
															Text="Opening Balance: " /> <Run
															Name="runOpeningBalance"
															FontWeight="Bold"
															Text="{Binding OpeningBalance}" /><LineBreak /><Run
															Text="Current Balance: " /> <Run
															Name="runCurrentBalance"
															FontWeight="Bold"
															Text="{Binding CurrentBalance}" /><LineBreak /></TextBlock>
												</ScrollViewer>
											</DockPanel>
										</Grid>
									</DockPanel>
								</Grid>
							</TabItem>
							<TabItem
								Header="A/c to A/c Entry">
								<Grid
									Name="TabOfficeAccounts">
									<DockPanel>
										<TextBlock
											DockPanel.Dock="Top"
											FontSize="20"
											FontFamily="Segoe Ui"
											FontWeight="Bold"
											Foreground="{StaticResource bg1}"
											HorizontalAlignment="Center">A/c to A/c Entry</TextBlock>
										<StackPanel
											DockPanel.Dock="Bottom"
											Margin="2">
											<WrapPanel
												HorizontalAlignment="Center">
												<Button
													Name="btnEditOfficeAccountEntry"
													Content="Edit Selected Entry"
													IsEnabled="False" />
											</WrapPanel>
											<DataGrid
												Name="DataGridOfficeAccount"
												IsReadOnly="True"
												MinHeight="165"
												Height="200"
												AutoGenerateColumns="False"
												CanUserAddRows="False"
												ScrollViewer.HorizontalScrollBarVisibility="Auto"
												ScrollViewer.VerticalScrollBarVisibility="Auto"
												SelectionMode="Single"
												Margin="-2,0,2,0"
												ItemsSource="{Binding}">
												<DataGrid.Columns>
													<DataGridTextColumn
														Header="Date"
														Binding="{Binding Date}" />
													<DataGridTextColumn
														Header="Amount"
														Binding="{Binding Amount}" />
													<DataGridTextColumn
														Header="Detail"
														Binding="{Binding Detail}" />
													<DataGridTextColumn
														Header="Credit From"
														Binding="{Binding CreditFrom}" />
													<DataGridTextColumn
														Header="Debit To"
														Binding="{Binding DebitTo}" />
												</DataGrid.Columns>
											</DataGrid>
										</StackPanel>
										<StackPanel
											Name="UniOfficeAccountDetails"
											VerticalAlignment="Top">
											<WrapPanel>
												<Label>Date:</Label>
												<DatePicker
													Name="OfficeAccountdatePicker"
													SelectedDateFormat="Short"
													SelectedDate="{x:Static sys:DateTime.Now}" />
											</WrapPanel>
											<WrapPanel>
												<Label>Amount:</Label>
												<TextBox
													Name="txtOfficeAccountAmount"
													ContextMenu="{x:Null}" />
											</WrapPanel>
											<WrapPanel>
												<Label>Detail:</Label>
												<TextBox
													Name="txtOfficeAccountDetail" />
											</WrapPanel>
											<WrapPanel>
												<Label>Credit From:</Label>
												<ComboBox
													Name="comboCAccounts"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													ItemsSource="{Binding BankAccounts}" />
											</WrapPanel>
											<WrapPanel>
												<Label>Debit To:</Label>
												<ComboBox
													Name="comboDAccounts"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													ItemsSource="{Binding BankAccounts}" />
											</WrapPanel>
											<WrapPanel>
												<Button
													Name="btnOfficeAccountEntry"
													IsDefault="True"
													IsEnabled="False">Enter Ac/Ac Entry</Button>
											</WrapPanel>
										</StackPanel>
									</DockPanel>
								</Grid>
							</TabItem>
							<TabItem
								Header="Misc. Auto Expense">
								<Grid
									Name="TabMiscExp">
									<DockPanel>
										<TextBlock
											DockPanel.Dock="Top"
											FontSize="20"
											FontFamily="Segoe Ui"
											FontWeight="Bold"
											Foreground="{StaticResource bg1}"
											HorizontalAlignment="Center">Auto Miscellaneous Expense Entry</TextBlock>
										<StackPanel
											DockPanel.Dock="Bottom"
											Margin="2">
											<WrapPanel
												HorizontalAlignment="Center">
												<Button
													Name="btnNewMiscExpEntry"
													Visibility="Collapsed"
													Content="Create New Entry" />
												<Button
													Name="btnEditMiscExpEntry"
													Content="Edit Selected Entry"
													IsEnabled="False" />
											</WrapPanel>
											<DataGrid
												Name="DataGridMiscExp"
												IsReadOnly="True"
												MinHeight="165"
												Height="200"
												AutoGenerateColumns="False"
												CanUserAddRows="False"
												ScrollViewer.HorizontalScrollBarVisibility="Auto"
												ScrollViewer.VerticalScrollBarVisibility="Auto"
												SelectionMode="Single"
												Margin="-2,0,2,0"
												ItemsSource="{Binding}">
												<DataGrid.Columns>
													<DataGridTextColumn
														Header="Chassis"
														Binding="{Binding chassis}" />
													<DataGridTextColumn
														Header="Date"
														Binding="{Binding DATE}" />
													<DataGridTextColumn
														Header="Amount"
														Binding="{Binding MiscExpAmount}" />
													<DataGridTextColumn
														Header="Detail"
														Binding="{Binding MiscExpDetail}" />
													<DataGridTextColumn
														Header="Account"
														Binding="{Binding MiscExpPaidBy}" />
												</DataGrid.Columns>
											</DataGrid>
										</StackPanel>
										<StackPanel
											Name="UniMiscDetails"
											VerticalAlignment="Top">
											<DockPanel>
												<Label>Auto Chassis No.</Label>
												<ComboBox
													Name="comboMiscChassis"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													ItemsSource="{Binding chassis}" />
											</DockPanel>
											<WrapPanel>
												<Label>Date:</Label>
												<DatePicker
													Name="MiscdatePicker"
													SelectedDateFormat="Short"
													SelectedDate="{x:Static sys:DateTime.Now}" />
											</WrapPanel>
											<WrapPanel>
												<Label>Expense Amount:</Label>
												<TextBox
													Name="txtMiscExpAmount"
													ContextMenu="{x:Null}" />
											</WrapPanel>
											<WrapPanel>
												<Label>Expense Detail:</Label>
												<TextBox
													Name="txtMiscExpDetail" />
											</WrapPanel>
											<WrapPanel>
												<Label>Account:</Label>
												<ComboBox
													Name="comboMiscAccounts"
													HorizontalAlignment="Left"
													VerticalAlignment="Top" />
											</WrapPanel>
											<WrapPanel>
												<Button
													Name="btnMiscExpEntry"
													IsDefault="True"
													IsEnabled="False">Enter Expense</Button>
											</WrapPanel>
										</StackPanel>
									</DockPanel>
								</Grid>
							</TabItem>
							<TabItem
								Header="Duty Payments">
								<Grid
									Name="TabDutyExp">
									<DockPanel>
										<TextBlock
											DockPanel.Dock="Top"
											FontSize="20"
											FontFamily="Segoe Ui"
											FontWeight="Bold"
											Foreground="{StaticResource bg1}"
											HorizontalAlignment="Center">Duty Expense Entry</TextBlock>
										<StackPanel
											DockPanel.Dock="Bottom"
											Margin="2">
											<WrapPanel
												HorizontalAlignment="Center">
												<Button
													Name="btnNewDutyExpEntry"
													Visibility="Collapsed"
													Content="Create New Entry" />
												<Button
													Name="btnEditDutyExpEntry"
													Content="Edit Selected Entry"
													IsEnabled="False" />
											</WrapPanel>
											<DataGrid
												Name="DataGridDutyExp"
												IsReadOnly="True"
												MinHeight="165"
												Height="200"
												AutoGenerateColumns="False"
												CanUserAddRows="False"
												ScrollViewer.HorizontalScrollBarVisibility="Auto"
												ScrollViewer.VerticalScrollBarVisibility="Auto"
												SelectionMode="Single"
												Margin="-2,0,2,0"
												ItemsSource="{Binding}">
												<DataGrid.Columns>
													<DataGridTextColumn
														Header="Chassis"
														Binding="{Binding chassis}" />
													<DataGridTextColumn
														Header="Date"
														Binding="{Binding DATE}" />
													<DataGridTextColumn
														Header="Amount"
														Binding="{Binding DutyExpAmount}" />
													<DataGridTextColumn
														Header="Detail"
														Binding="{Binding DutyExpDetail}" />
													<DataGridTextColumn
														Header="Account"
														Binding="{Binding DutyExpPaidBy}" />
													<DataGridTextColumn
														Header="Agent"
														Binding="{Binding DutyExpAgent}" />
												</DataGrid.Columns>
											</DataGrid>
										</StackPanel>
										<UniformGrid
											Name="UniDutyDetails"
											VerticalAlignment="Top"
											Columns="2">
											<DockPanel>
												<Label>Auto Chassis No.</Label>
												<ComboBox
													Name="comboDutyChassis"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													ItemsSource="{Binding chassis}" />
											</DockPanel>
											<WrapPanel>
												<Label>Date:</Label>
												<DatePicker
													Name="DutydatePicker"
													SelectedDateFormat="Short"
													SelectedDate="{x:Static sys:DateTime.Now}" />
											</WrapPanel>
											<WrapPanel>
												<Label>Expense Amount:</Label>
												<TextBox
													Name="txtDutyExpAmount"
													ContextMenu="{x:Null}" />
											</WrapPanel>
											<WrapPanel>
												<Label>Expense Detail:</Label>
												<TextBox
													Name="txtDutyExpDetail" />
