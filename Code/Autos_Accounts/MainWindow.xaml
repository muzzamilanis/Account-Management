												Text="{Binding Name}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ListView>
								<DockPanel
									Name="CustDetails"
									Grid.Column="1"
									VerticalAlignment="Top"
									DataContext="{Binding ElementName=LstCust, Path=SelectedItem}">
									<TextBlock
										DockPanel.Dock="Top"
										HorizontalAlignment="Center"
										FontWeight="Bold"
										Text="Selected Customer Details"
										LineHeight="25" />
									<ScrollViewer
										VerticalScrollBarVisibility="Auto">
										<TextBlock
											Name="TxtBlkCustDetails"
											FontFamily="Segoe UI"
											ScrollViewer.HorizontalScrollBarVisibility="Disabled"
											LineHeight="25">
											<Run
												Text="Id: " /> <Run
												Name="RunCustId"
												FontWeight="Bold"
												Text="{Binding rowid}" /> <Run
												Text="Date: " /> <Run
												Name="RunCustDate"
												FontWeight="Bold"
												Text="{Binding DATE}" /><LineBreak /><Run
												Text="Title: " /> <Run
												Name="RunCustTitle"
												FontWeight="Bold"
												Text="{Binding Title}" /><LineBreak /><Run
												Text="Name: " /> <Run
												Name="RunCustName"
												FontWeight="Bold"
												Text="{Binding Name}" /><LineBreak /><Run
												Text="C.N.I.C. No.: " /> <Run
												Name="RunCustCNIC"
												FontWeight="Bold"
												Text="{Binding CNIC}" /><LineBreak /><Run
												Text="Phone No.: " /> <Run
												Name="RunCustPhone"
												FontWeight="Bold"
												Text="{Binding Phone}" /><LineBreak /><Run
												Text="Address: " /> <Run
												Name="RunCustAddress"
												FontWeight="Bold"
												Text="{Binding Address}" /><LineBreak /><Run
												Name="runCustRecPay"
												Text="Payment Receivable: " /> <Run
												Name="RunCustPaymentReceivable"
												FontWeight="Bold"
												Text="{Binding PaymentReceivable}" /></TextBlock>
									</ScrollViewer>
								</DockPanel>
							</Grid>
						</DockPanel>
					</Grid>
				</TabItem>
				<TabItem
					Header="Manage Agents">
					<Grid
						Name="TabAgent">
						<DockPanel
							Name="staAgentData">
							<StackPanel
								Name="GrpAgentBtns"
								DockPanel.Dock="Top"
								Orientation="Horizontal"
								HorizontalAlignment="Center">
								<Button
									Name="BtnAddAgent"
									IsEnabled="False">Add New Agent</Button>
								<Button
									Name="BtnEditAgent"
									IsEnabled="False">Edit Selected Agent</Button>
							</StackPanel>
							<Grid
								DockPanel.Dock="Top"
								HorizontalAlignment="Left"
								Height="30"
								Width="{Binding ElementName=LstAgent, Path=ActualWidth}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
								<Label
									Name="lblAgentFilter"
									Content="Filter:"
									HorizontalAlignment="Left" />
								<TextBox
									Name="txtAgentFilter"
									Grid.Column="1"
									Width="auto" />
							</Grid>
							<StackPanel
								DockPanel.Dock="Bottom">
								<TextBlock
									DockPanel.Dock="Bottom">
									<Run
										Text="Total Agents: " /> <Run
										FontWeight="Bold"
										Text="{Binding ElementName=LstAgent, Path=Items.Count, Mode=OneWay}" /></TextBlock>
							</StackPanel>
							<Grid
								Name="AgentGrid">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="4*" />
									<ColumnDefinition
										Width="6*" />
								</Grid.ColumnDefinitions>
								<ListView
									Name="LstAgent"
									DockPanel.Dock="Left"
									SelectionMode="Extended">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock
												Text="{Binding Name}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ListView>
								<DockPanel
									Name="AgentDetails"
									Grid.Column="1"
									VerticalAlignment="Top"
									DataContext="{Binding ElementName=LstAgent, Path=SelectedItem}">
									<TextBlock
										DockPanel.Dock="Top"
										HorizontalAlignment="Center"
										FontWeight="Bold"
										Text="Selected Agent Details"
										LineHeight="25" />
									<ScrollViewer
										VerticalScrollBarVisibility="Auto">
										<TextBlock
											Name="TxtBlkAgentDetails"
											FontFamily="Segoe UI"
											ScrollViewer.HorizontalScrollBarVisibility="Disabled"
											LineHeight="25">
											<Run
												Text="Id: " /> <Run
												Name="RunAgentId"
												FontWeight="Bold"
												Text="{Binding rowid}" /><LineBreak /><Run
												Text="Date: " /> <Run
												Name="RunAgentDate"
												FontWeight="Bold"
												Text="{Binding DATE}" /><LineBreak /><Run
												Text="Name: " /> <Run
												Name="RunAgentName"
												FontWeight="Bold"
												Text="{Binding Name}" /><LineBreak /><Run
												Text="C.N.I.C. No.: " /> <Run
												Name="RunAgentCNIC"
												FontWeight="Bold"
												Text="{Binding CNIC}" /><LineBreak /><Run
												Text="Phone No.: " /> <Run
												Name="RunAgentPhone"
												FontWeight="Bold"
												Text="{Binding Phone}" /><LineBreak /><Run
												Text="Address: " /> <Run
												Name="RunAgentAddress"
												FontWeight="Bold"
												Text="{Binding Address}" /><LineBreak /><Run
												Name="runAgentRecPay"
												Text="Payment Receivable: " /> <Run
												Name="RunAgentPaymentReceivable"
												FontWeight="Bold"
												Text="{Binding PaymentReceivable}" /></TextBlock>
									</ScrollViewer>
								</DockPanel>
							</Grid>
						</DockPanel>
					</Grid>
				</TabItem>
				<TabItem
					Header="Sale Autos">
					<Grid
						Name="TabSale">
						<DockPanel>
							<TextBlock
								Margin="0,0,0,5"
								DockPanel.Dock="Top"
								FontSize="20"
								FontFamily="Segoe Ui"
								FontWeight="Bold"
								Foreground="{StaticResource bg1}"
								HorizontalAlignment="Center">Auto Sale Entry</TextBlock>
							<StackPanel
								DockPanel.Dock="Bottom"
								Margin="2">
								<WrapPanel
									HorizontalAlignment="Center">
									<Button
										Name="btnNewSaleEntry"
										Content="Create New Sale Entry" />
									<Button
										Name="btnEditSaleEntry"
										Content="Edit Selected Entry"
										IsEnabled="False" />
								</WrapPanel>
								<DataGrid
									Name="DataGridSales"
									IsReadOnly="True"
									Height="200"
									AutoGenerateColumns="False"
									CanUserAddRows="False"
									ScrollViewer.HorizontalScrollBarVisibility="Auto"
									ScrollViewer.VerticalScrollBarVisibility="Auto"
									SelectionMode="Single"
									Margin="-2,0,2,0"
									ItemsSource="{Binding}">
									<DataGrid.Columns>
										<DataGridTextColumn
											Header="Date"
											Binding="{Binding SaleDate}" />
										<DataGridTextColumn
											Header="Chassis"
											Binding="{Binding SaleChassis}" />
										<DataGridTextColumn
											Header="Customer"
											Binding="{Binding SaleCustomer}" />
										<DataGridTextColumn
											Header="Price"
											Binding="{Binding SalePrice}" />
										<DataGridTextColumn
											Header="Advanced Received"
											Binding="{Binding SaleAmountReceived}" />
										<DataGridTextColumn
											Header="Received In"
											Binding="{Binding PaymentReceivedIn}" />
									</DataGrid.Columns>
								</DataGrid>
							</StackPanel>
							<UniformGrid
								Name="UniDetails"
								VerticalAlignment="Top"
								Columns="2">
								<WrapPanel>
									<Label>Auto Chassis No.</Label>
									<ComboBox
										Name="comboChassis"
										HorizontalAlignment="Left"
										VerticalAlignment="Top" />
								</WrapPanel>
								<WrapPanel>
									<Label>Customer:</Label>
									<ComboBox
										Name="comboCust"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										ItemsSource="{Binding customer}" />
								</WrapPanel>
								<WrapPanel>
									<Label>Sale Price:</Label>
									<TextBox
										Name="txtSalePrice"
										ContextMenu="{x:Null}" />
								</WrapPanel>
								<WrapPanel>
									<Label>Amount Received:</Label>
									<xctk:IntegerUpDown
										Name="txtAmountReceived"
										Minimum="0"
										Width="125"
										Maximum="{Binding ElementName=txtSalePrice, Path=Text}" />
								</WrapPanel>
								<WrapPanel>
									<Label>Payment Recieved In:</Label>
									<ComboBox
										Name="comboSaleAccounts"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										ItemsSource="{Binding Accounts}" />
								</WrapPanel>
								<WrapPanel>
									<Label>Date:</Label>
									<DatePicker
										Name="SaleDatePicker"
										SelectedDateFormat="Short"
										SelectedDate="{x:Static sys:DateTime.Now}" />
								</WrapPanel>
								<WrapPanel>
									<Button
										Name="btnSaleEntry"
										IsDefault="True"
										IsEnabled="False">Click to Sale</Button>
								</WrapPanel>
							</UniformGrid>
						</DockPanel>
					</Grid>
				</TabItem>
				<TabItem
					Header="Report">
					<Grid>
						<DockPanel>
							<StackPanel
								DockPanel.Dock="Top">
								<WrapPanel
									Margin="10">
									<ComboBox
										Name="comboReport"
										SelectedValuePath="Content"
										Width="250">
										<ComboBoxItem
											IsSelected="True">Sold Cars</ComboBoxItem>
										<ComboBoxItem>Accounts</ComboBoxItem>
										<ComboBoxItem>Stocks</ComboBoxItem>
										<ComboBoxItem>Accounts Receivable</ComboBoxItem>
										<ComboBoxItem>Accounts Payable</ComboBoxItem>
										<ComboBoxItem>Trial Balance</ComboBoxItem>
										<ComboBoxItem>Income Statement</ComboBoxItem>
										<ComboBoxItem>Office Expenses</ComboBoxItem>
										<ComboBoxItem>Misc. Auto Expenses</ComboBoxItem>
										<ComboBoxItem>Duty Expenses</ComboBoxItem>
										<ComboBoxItem>Receipts</ComboBoxItem>
										<ComboBoxItem>Party Ledger</ComboBoxItem>
										<ComboBoxItem>Yen Payments</ComboBoxItem>
									</ComboBox>
									<ComboBox
										Name="comboReportAccounts"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										Visibility="Collapsed"
										MinWidth="150"
										ItemsSource="{Binding Accounts}" />
									<ComboBox
										Name="comboReportCustomers"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										Visibility="Collapsed"
										MinWidth="150"
										ItemsSource="{Binding Name}" />
									<ComboBox
										Name="comboReportDutyAgents"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										Visibility="Collapsed"
										MinWidth="150"
										ItemsSource="{Binding Name}" />
									<ComboBox
										Name="comboReportStockDuty"
										Visibility="Collapsed"
										MinWidth="150">
										<ComboBoxItem
											IsSelected="True">All</ComboBoxItem>
										<ComboBoxItem>Duty Paid</ComboBoxItem>
										<ComboBoxItem>Duty Not Paid</ComboBoxItem>
									</ComboBox>
									<WrapPanel
										Name="reportDate">
										<Label
											Content="From: " />
										<DatePicker
											Name="reportDateFrom"
											SelectedDateFormat="Short"
											SelectedDate="2017-01-01" />
										<Label
											Content="To: " />
										<DatePicker
											Name="reportDateTo"
											SelectedDateFormat="Short"
											SelectedDate="{x:Static sys:DateTime.Now}" />
									</WrapPanel>
									<Button
										Name="btnGenerateReport"
										Content="Generate Report" />
								</WrapPanel>
							</StackPanel>
							<StackPanel
								DockPanel.Dock="Bottom">
								<Button
									Name="btnClosing"
									Content="Close All Entries"
									Visibility="Collapsed" />
							</StackPanel>
							<DocumentViewer
								Name="documentViewer2"
								Visibility="Collapsed" />
							<FlowDocumentScrollViewer
								Name="flowviewertrial"
								Visibility="Collapsed">
								<FlowDocument
									Name="flowTrialBalance"
									PagePadding="25"
									PageHeight="29.7cm"
									PageWidth="21cm"
									ColumnWidth="21cm">
									<Section>
										<Paragraph
											TextAlignment="Center"
											FontSize="22"
											FontWeight="Bold">JAINI MOTORS</Paragraph>
										<Paragraph>
											<Run
												Name="runT"
												Text="Trial Balance" />
											<LineBreak />
											<Run
												Name="runD" /> <Hyperlink>Print</Hyperlink></Paragraph>
									</Section>
									<Table
										Name="TableTrialBalance"
										CellSpacing="0"
										BorderBrush="#FF000000"
										BorderThickness="0.02cm"
										FontFamily="Segoe UI">
										<FrameworkContentElement.Resources>
											<ResourceDictionary>
												<Style
													x:Name="headerFooterRowStyle"
													TargetType="{x:Type TableRowGroup}"
													x:Key="headerFooterRowStyle">
													<Setter
														Property="FontWeight"
														Value="DemiBold" />
													<Setter
														Property="FontSize"
														Value="14" />
													<Setter
														Property="Background"
														Value="#FFD3D3D3" />
												</Style>
												<Style
													TargetType="{x:Type Paragraph}"
													x:Key="{x:Type Paragraph}">
													<Setter
														Property="Block.BorderBrush"
														Value="#FF000000" />
												</Style>
												<Style
													TargetType="{x:Type TableRowGroup}"
													x:Key="dataRowStyle">
													<Setter
														Property="FontSize"
														Value="12" />
												</Style>
												<Style
													TargetType="{x:Type TableCell}"
													x:Key="{x:Type TableCell}">
													<Setter
														Property="TableCell.Padding"
														Value="0.1cm" />
													<Setter
														Property="TableCell.BorderBrush"
														Value="#FF000000" />
													<Setter
														Property="TableCell.BorderThickness"
														Value="0.01cm" />
												</Style>
											</ResourceDictionary>
										</FrameworkContentElement.Resources>
										<Table.Columns>
											<TableColumn
												Width="40*" />
											<TableColumn
												Width="20*" />
											<TableColumn
												Width="20*" />
										</Table.Columns>
										<TableRowGroup
											Style="{StaticResource headerFooterRowStyle}">
											<TableRow>
												<TableCell />
												<TableCell
													TextAlignment="Right">
													<Paragraph>
														<Bold>Debit</Bold>
													</Paragraph>
												</TableCell>
												<TableCell
													TextAlignment="Right">
													<Paragraph>
														<Bold>Credit</Bold>
													</Paragraph>
												</TableCell>
											</TableRow>
										</TableRowGroup>
										<TableRowGroup
											Name="trg1"
											Style="{StaticResource dataRowStyle}">
											<xrd:TableRowForDataTable
												TableName="StocksTable">
												<TableCell>
													<Paragraph>
														<xrd:InlineTableCellValue
															PropertyName="Chassis" />
													</Paragraph>
												</TableCell>
												<TableCell>
													<Paragraph>
														<xrd:InlineTableCellValue
															PropertyName="PaymentReceivable"
															AggregateGroup="SalePriceGroup" />
													</Paragraph>
												</TableCell>
											</xrd:TableRowForDataTable>
										</TableRowGroup>
										<TableRowGroup
											Style="{StaticResource headerFooterRowStyle}">
											<TableRow>
												<TableCell
													TextAlignment="Right">
													<Paragraph />
												</TableCell>
											</TableRow>
										</TableRowGroup>
									</Table>
									<Paragraph>
										<TextBlock
											FontSize="10">** Accounts Payable on Stock Purchase is calculated with default exchange rate</TextBlock>
									</Paragraph>
								</FlowDocument>
							</FlowDocumentScrollViewer>
						</DockPanel>
					</Grid>
				</TabItem>
			</TabControl>
		</DockPanel>
	</Grid>
</Window>
