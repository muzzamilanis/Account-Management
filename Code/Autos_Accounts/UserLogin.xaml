<!--Class 'Autos_Accounts.UserLogin' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
	x:Class="Autos_Accounts.UserLogin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Autos_Accounts"
	Title="UserLogin"
	Height="150"
	Width="300"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	Background="{StaticResource bg2}">
	<Grid>
		<DockPanel
			Name="dockAddAccounts">
			<WrapPanel
				DockPanel.Dock="Bottom"
				HorizontalAlignment="Right">
				<Button
					Name="Register"
					Content="Register Now"
					Visibility="Collapsed" />
				<Button
					Name="OK"
					Content="OK"
					Width="67"
					IsDefault="True" />
				<Button
					Name="Cancel"
					Content="Cancel"
					Width="67"
					IsCancel="True" />
			</WrapPanel>
			<StackPanel
				DockPanel.Dock="Top"
				Background="{StaticResource bg1}">
				<TextBlock
					Name="AccInfoText"
					FontSize="16"
					FontFamily="Segoe UI"
					FontWeight="Bold"
					Foreground="{StaticResource bg2}"
					Margin="3"
					Text="Auto Accounts Manager"
					HorizontalAlignment="Center"
					DockPanel.Dock="Top" />
			</StackPanel>
			<StackPanel
				VerticalAlignment="Center">
				<WrapPanel>
					<Label>Password:</Label>
					<PasswordBox
						Name="txtPass"
						Width="200"
						TabIndex="-1"
						Panel.ZIndex="-1" />
				</WrapPanel>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
