<!--Class 'Autos_Accounts.UserLogin' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
    x:Class="Autos_Accounts.UserLogin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Autos_Accounts"
    Title="Jaini Auto Accounts — Login"
    Height="320" Width="420"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.55"/>
    </Window.Resources>

    <!-- Outer border: drop shadow container -->
    <Border Margin="12" CornerRadius="14"
            Background="{StaticResource bg2}"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header Banner ── -->
            <Border Grid.Row="0" CornerRadius="14 14 0 0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#0C2A3E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" Margin="24 0">
                    <TextBlock FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               Text="Jaini Auto Accounts Manager"/>
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               Margin="0 4 0 0"
                               Text="Please enter your password to continue"/>
                </StackPanel>
            </Border>

            <!-- Accent underline on header -->
            <Rectangle Grid.Row="0" Height="2" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#38BDF8" Offset="0"/>
                        <GradientStop Color="#0EA5E9" Offset="0.5"/>
                        <GradientStop Color="#0F172A" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ── Form Area ── -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="28 16">
                <!-- Password label + field -->
                <TextBlock Text="PASSWORD"
                           FontSize="10"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0 0 0 6"/>
                <PasswordBox Name="txtPass"
                             Width="320"
                             HorizontalAlignment="Left"
                             TabIndex="-1"
                             Panel.ZIndex="-1"/>
            </StackPanel>

            <!-- ── Footer Buttons ── -->
            <Border Grid.Row="2"
                    CornerRadius="0 0 14 14"
                    Background="{StaticResource bg1}"
                    Padding="20 12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Name="Register"
                            Content="Register Now"
                            Visibility="Collapsed"/>
                    <Button Name="OK"
                            Content="Sign In"
                            Width="100"
                            IsDefault="True"/>
                    <Button Name="Cancel"
                            Content="Cancel"
                            Width="90"
                            IsCancel="True"
                            Style="{StaticResource OutlineButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
