<!--Class 'Autos_Accounts.PurchaseAuto' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
	x:Class="Autos_Accounts.PurchaseAuto" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Autos_Accounts"
	Title="Purchase Auto"
	Height="500"
	Width="300"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	Background="{StaticResource bg2}">
	<Grid>
		<DockPanel
			Name="dockAddAccounts">
			<WrapPanel
				DockPanel.Dock="Bottom"
				HorizontalAlignment="Right"
				Height="35">
				<Button
					Name="OK"
					Content="OK"
					Width="67"
					IsDefault="True" />
				<Button
					Name="Cancel"
					Content="Cancel"
					Width="67"
					IsCancel="True" />
			</WrapPanel>
			<TextBlock
				Name="AccInfoText"
				FontSize="16"
				FontFamily="Segoe UI"
				Margin="3"
				Text="Add Auto Purchase Entry"
				HorizontalAlignment="Center"
				DockPanel.Dock="Top" />
			<StackPanel
				VerticalAlignment="Center">
				<WrapPanel>
					<Label>Date:</Label>
					<DatePicker
						Name="PaymentdatePicker"
						SelectedDateFormat="Short"
						SelectedDate="{x:Static sys:DateTime.Now}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Chassis No.:</Label>
					<TextBox
						Name="txtPurChassisNo" />
				</WrapPanel>
				<WrapPanel>
					<Label>Model:</Label>
					<TextBox
						Name="txtPurModel" />
				</WrapPanel>
				<WrapPanel>
					<Label>Color:</Label>
					<TextBox
						Name="txtPurColor" />
				</WrapPanel>
				<WrapPanel>
					<Label>Purchase Price (Yen):</Label>
					<TextBox
						Name="txtPaymentPrice"
						ContextMenu="{x:Null}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Amount Paid:</Label>
					<xctk:IntegerUpDown
						Name="intPaymentAmount"
						UpDownBase_x0060_1.Minimum="0"
						Width="125"
						UpDownBase_x0060_1.Maximum="{Binding ElementName=txtPaymentPrice, Path=Text}" />
					<TextBox
						Name="txtPaymentAmount"
						Visibility="Collapsed"
						ContextMenu="{x:Null}"
						Text="{Binding ElementName=intPaymentAmount, Path=Value}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Exchange Rate:</Label>
					<TextBox
						Name="txtPaymentRate"
						Text="{Binding Source={x:Static local:MySettings.Default}, Path=exchangeRate, Mode=OneWay}"
						ContextMenu="{x:Null}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Amount in PKR:</Label>
					<TextBox
						Name="txtPaymentAmountPkr"
						IsEnabled="False" />
				</WrapPanel>
				<WrapPanel>
					<Label>Duty:</Label>
					<TextBox
						Name="txtPurDuty"
						Text="0" />
				</WrapPanel>
				<WrapPanel>
					<Label>Agent:</Label>
					<ComboBox
						Name="comboDutyAgents"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						ItemsSource="{Binding Name}" />
					<Button
						Name="btnDutyAddAgent">Add New</Button>
				</WrapPanel>
				<WrapPanel>
					<Label>Misc. Expenses:</Label>
					<TextBox
						Name="txtPurMiscExp"
						Text="0" />
				</WrapPanel>
				<WrapPanel>
					<Label>Paid From:</Label>
					<ComboBox
						Name="comboPaymentAccounts"
						SelectedValuePath="Content"
						HorizontalAlignment="Left"
						VerticalAlignment="Top" />
				</WrapPanel>
				<WrapPanel>
					<Label>Other Comments:</Label>
					<TextBox
						Name="txtPurComments" />
				</WrapPanel>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
