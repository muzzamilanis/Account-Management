<!--Class 'Autos_Accounts.PaymentAgentEntry' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
	x:Class="Autos_Accounts.PaymentAgentEntry" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:local="clr-namespace:Autos_Accounts"
	Title="PaymentAgentEntry"
	Height="300"
	Width="300"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	Background="{StaticResource bg2}">
	<Grid>
		<DockPanel
			Name="dockSaleEntry">
			<WrapPanel
				DockPanel.Dock="Bottom"
				HorizontalAlignment="Right"
				Height="35">
				<Button
					Name="OK"
					Content="OK"
					Width="67"
					IsDefault="True" />
				<Button
					Name="Cancel"
					Content="Cancel"
					Width="67"
					IsCancel="True" />
			</WrapPanel>
			<TextBlock
				Name="AccInfoText"
				FontSize="16"
				FontFamily="Segoe UI"
				Margin="3"
				Text="New Agent Payment Entry"
				HorizontalAlignment="Center"
				DockPanel.Dock="Top" />
			<StackPanel
				Name="UniPaymentAgentDetails"
				VerticalAlignment="Top">
				<WrapPanel>
					<Label>Paying to:</Label>
					<ComboBox
						Name="comboPaymentAgent"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						ItemsSource="{Binding Agent}" />
					<Button
						Name="BtnAddAgentatPay"
						Content="Add Agent"
						Margin="5,0" />
				</WrapPanel>
				<WrapPanel>
					<Label>Date:</Label>
					<DatePicker
						Name="PaymentAgentdatePicker"
						SelectedDateFormat="Short"
						SelectedDate="{x:Static sys:DateTime.Now}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Amount:</Label>
					<TextBox
						Name="txtPaymentAgentAmount"
						ContextMenu="{x:Null}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Detail:</Label>
					<TextBox
						Name="txtPaymentAgentDetail" />
				</WrapPanel>
				<WrapPanel>
					<Label>Paying from:</Label>
					<ComboBox
						Name="comboPaymentAgentAccounts"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						ItemsSource="{Binding Accounts}" />
				</WrapPanel>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
