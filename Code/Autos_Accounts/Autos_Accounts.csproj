<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Autos_Accounts</RootNamespace>
    <AssemblyName>Autos_Accounts</AssemblyName>
    <ApplicationIcon>Autos_Accounts.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x86</Platforms>
    <StartupObject>Autos_Accounts.Application</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.6.1" />
  </ItemGroup>

  <!-- Local DLL References (no NuGet equivalent) -->
  <ItemGroup>
    <Reference Include="AES256">
      <HintPath>..\..\AES256.dll</HintPath>
    </Reference>
    <Reference Include="CodeReason.Reports">
      <HintPath>..\..\CodeReason.Reports.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="ReachFramework" />
  </ItemGroup>

  <!-- Resource Files -->
  <ItemGroup>
    <Resource Include="car-logo.ico" />
    <Resource Include="car_logo2_91g_icon.ico" />
    <Resource Include="Autos_Accounts.ico" />
  </ItemGroup>

  <!-- Embedded Resources -->
  <ItemGroup>
    <EmbeddedResource Include="Resources.resources" />
  </ItemGroup>

  <!-- App Settings -->
  <ItemGroup>
    <None Include="app.config" />
    <None Include="MySettings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>MySettings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Report Template -->
  <ItemGroup>
    <Page Include="templates\simplereport.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

</Project>