<!--Class 'Autos_Accounts.SaleAuto' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
    x:Class="Autos_Accounts.SaleAuto"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:local="clr-namespace:Autos_Accounts"
    Title="Sale Auto"
    Height="380" Width="380"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="{StaticResource bg1}">

    <DockPanel Name="dockSaleEntry" LastChildFill="True">

        <!-- Title Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource bg1}" Padding="18 14">
            <StackPanel>
                <TextBlock Name="AccInfoText"
                           Text="New Sale Entry"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           FontFamily="Segoe UI Variable, Segoe UI"/>
                <Rectangle Height="1.5" Margin="0 8 0 0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#38BDF8" Offset="0"/>
                            <GradientStop Color="#0F172A" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource bg1}" Padding="12 10">
            <WrapPanel HorizontalAlignment="Right">
                <Button Name="OK" Content="Save Sale" Width="100" IsDefault="True"/>
                <Button Name="Cancel" Content="Cancel" Width="80" IsCancel="True"
                        Style="{StaticResource OutlineButton}"/>
            </WrapPanel>
        </Border>

        <!-- Form Body -->
        <Border Background="{StaticResource bg2}" Padding="14 8">
            <StackPanel Name="UniDetails" VerticalAlignment="Center">
                <WrapPanel>
                    <Label Name="lblchassis">Auto Chassis No.</Label>
                    <ComboBox Name="comboChassis" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </WrapPanel>
                <WrapPanel>
                    <Label>Customer:</Label>
                    <ComboBox Name="comboCust" HorizontalAlignment="Left"
                              VerticalAlignment="Top" ItemsSource="{Binding customer}"/>
                </WrapPanel>
                <WrapPanel>
                    <Label>Sale Price:</Label>
                    <TextBox Name="txtSalePrice" ContextMenu="{x:Null}"/>
                </WrapPanel>
                <WrapPanel>
                    <Label>Amount Received:</Label>
                    <xctk:IntegerUpDown Name="txtAmountReceived"
                                        Minimum="0" Width="130"
                                        Maximum="{Binding ElementName=txtSalePrice, Path=Text}"/>
                </WrapPanel>
                <WrapPanel>
                    <Label>Payment Received In:</Label>
                    <ComboBox Name="comboSaleAccounts" HorizontalAlignment="Left"
                              VerticalAlignment="Top" ItemsSource="{Binding Accounts}"/>
                </WrapPanel>
                <WrapPanel>
                    <Label>Date:</Label>
                    <DatePicker Name="SaleDatePicker" SelectedDateFormat="Short"
                                SelectedDate="{x:Static sys:DateTime.Now}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
