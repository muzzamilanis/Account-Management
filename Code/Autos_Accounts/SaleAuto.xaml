<!--Class 'Autos_Accounts.SaleAuto' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
	x:Class="Autos_Accounts.SaleAuto" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:local="clr-namespace:Autos_Accounts"
	Title="Sale Auto"
	Height="310.15"
	Width="300"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	Background="{StaticResource bg2}">
	<Grid>
		<DockPanel
			Name="dockSaleEntry">
			<WrapPanel
				DockPanel.Dock="Bottom"
				HorizontalAlignment="Right"
				Height="35">
				<Button
					Name="OK"
					Content="OK"
					Width="67"
					IsDefault="True" />
				<Button
					Name="Cancel"
					Content="Cancel"
					Width="67"
					IsCancel="True" />
			</WrapPanel>
			<TextBlock
				Name="AccInfoText"
				FontSize="16"
				FontFamily="Segoe UI"
				Margin="3"
				Text="New Sale Entry"
				HorizontalAlignment="Center"
				DockPanel.Dock="Top" />
			<StackPanel
				Name="UniDetails"
				VerticalAlignment="Center">
				<WrapPanel>
					<Label
						Name="lblchassis">Auto Chassis No.</Label>
					<ComboBox
						Name="comboChassis"
						HorizontalAlignment="Left"
						VerticalAlignment="Top" />
				</WrapPanel>
				<WrapPanel>
					<Label>Customer:</Label>
					<ComboBox
						Name="comboCust"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						ItemsSource="{Binding customer}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Sale Price:</Label>
					<TextBox
						Name="txtSalePrice"
						ContextMenu="{x:Null}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Amount Received:</Label>
					<xctk:IntegerUpDown
						Name="txtAmountReceived"
						UpDownBase_x0060_1.Minimum="0"
						Width="125"
						UpDownBase_x0060_1.Maximum="{Binding ElementName=txtSalePrice, Path=Text}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Payment Recieved In:</Label>
					<ComboBox
						Name="comboSaleAccounts"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						ItemsSource="{Binding Accounts}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Date:</Label>
					<DatePicker
						Name="SaleDatePicker"
						SelectedDateFormat="Short"
						SelectedDate="{x:Static sys:DateTime.Now}" />
				</WrapPanel>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
