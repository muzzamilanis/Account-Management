<!--Class 'Autos_Accounts.ReceiptEntry' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
	x:Class="Autos_Accounts.ReceiptEntry" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Autos_Accounts" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
	Title="Receipt Entry"
	Height="300"
	Width="300"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	Background="{StaticResource bg2}">
	<Grid>
		<DockPanel
			Name="dockSaleEntry">
			<WrapPanel
				DockPanel.Dock="Bottom"
				HorizontalAlignment="Right"
				Height="35">
				<Button
					Name="OK"
					Content="OK"
					Width="67"
					IsDefault="True" />
				<Button
					Name="Cancel"
					Content="Cancel"
					Width="67"
					IsCancel="True" />
			</WrapPanel>
			<TextBlock
				Name="AccInfoText"
				FontSize="16"
				FontFamily="Segoe UI"
				Margin="3"
				Text="New Receipt Entry"
				HorizontalAlignment="Center"
				DockPanel.Dock="Top" />
			<StackPanel
				Name="UniReceiptDetails"
				VerticalAlignment="Top">
				<WrapPanel>
					<Label>Received From:</Label>
					<ComboBox
						Name="comboReceiptCust"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						ItemsSource="{Binding customer}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Date:</Label>
					<DatePicker
						Name="ReceiptdatePicker"
						SelectedDateFormat="Short"
						SelectedDate="{x:Static sys:DateTime.Now}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Amount:</Label>
					<TextBox
						Name="txtReceiptAmount"
						ContextMenu="{x:Null}" />
				</WrapPanel>
				<WrapPanel>
					<Label>Detail:</Label>
					<TextBox
						Name="txtReceiptDetail" />
				</WrapPanel>
				<WrapPanel>
					<Label>Recieving In:</Label>
					<ComboBox
						Name="comboReceiptAccounts"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						ItemsSource="{Binding Accounts}" />
				</WrapPanel>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
