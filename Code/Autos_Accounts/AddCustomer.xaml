<!--Class 'Autos_Accounts.AddCustomer' has IComponentConnector.Connect method, but cannot be parsed.-->
<Window
	x:Class="Autos_Accounts.AddCustomer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Autos_Accounts"
	Title="Add Customer"
	Height="300"
	Width="300"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	Background="{StaticResource bg2}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type TextBox}"
				x:Key="{x:Type TextBox}">
				<Setter
					Property="MinWidth"
					Value="100" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<DockPanel
			Name="dockAddCustomer">
			<WrapPanel
				DockPanel.Dock="Bottom"
				HorizontalAlignment="Right"
				Height="35">
				<Button
					Name="OK"
					Content="OK"
					Width="67"
					IsDefault="True" />
				<Button
					Name="Cancel"
					Content="Cancel"
					Width="67"
					IsCancel="True" />
			</WrapPanel>
			<TextBlock
				Name="AccInfoText"
				FontSize="16"
				FontFamily="Segoe UI"
				Margin="3"
				Text="Add Customer Entry"
				HorizontalAlignment="Center"
				DockPanel.Dock="Top" />
			<StackPanel
				VerticalAlignment="Center">
				<WrapPanel>
					<Label>Date:</Label>
					<DatePicker
						Name="CustdatePicker"
						SelectedDateFormat="Short"
						SelectedDate="{x:Static sys:DateTime.Now}" />
				</WrapPanel>
				<DockPanel
					Height="auto">
					<Label>Title:</Label>
					<TextBox
						Name="txtCustTitle" />
				</DockPanel>
				<DockPanel>
					<Label>Customer Name:</Label>
					<TextBox
						Name="txtCustName" />
				</DockPanel>
				<DockPanel>
					<Label>C.N.I.C. No.:</Label>
					<xctk:MaskedTextBox
						Name="txtCnicNo"
						Mask="00000-0000000-0"
						IncludeLiteralsInValue="False"
						CaretIndex="0"
						ResetOnSpace="False"
						ResetOnPrompt="True"
						ValueDataType="{x:Type sys:String}" />
				</DockPanel>
				<DockPanel>
					<Label>Phone No.:</Label>
					<TextBox
						Name="txtCustPhoneNo"
						MaxLength="16"
						ContextMenu="{x:Null}" />
				</DockPanel>
				<DockPanel>
					<Label>Address:</Label>
					<TextBox
						Name="txtCustAddress" />
				</DockPanel>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
